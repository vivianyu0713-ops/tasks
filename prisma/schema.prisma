// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskType {
  TASK
  REQUIREMENT
  PROJECT
  DAILY_WORK
  INCIDENT
}

enum TaskStatus {
  INBOX
  TODO
  DOING
  WAITING
  BLOCKED
  REVIEW
  DONE
  CANCELLED
  ARCHIVED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  type          TaskType     @default(TASK)
  status        TaskStatus   @default(INBOX)
  priority      TaskPriority @default(MEDIUM)
  level         String?
  dueDate       DateTime?
  reminderAt    DateTime?
  nextAction    String?
  blockedReason String?
  source        String?
  externalUrl   String?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assigneeId    String?
  requirementId String?
  projectId     String?
  dailyWorkId   String?
  incidentId    String?

  assignee    Person?     @relation(fields: [assigneeId], references: [id])
  requirement Requirement? @relation(fields: [requirementId], references: [id])
  project     Project?     @relation(fields: [projectId], references: [id])
  dailyWork   DailyWork?   @relation(fields: [dailyWorkId], references: [id])
  incident    Incident?    @relation(fields: [incidentId], references: [id])
  notes       TaskNote[]
  tags        TaskTag[]

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([type])
  @@index([updatedAt])
}

model Person {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Requirement {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
}

model DailyWork {
  id          String   @id @default(cuid())
  title       String
  description String?
  cadence     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
}

model Incident {
  id          String   @id @default(cuid())
  title       String
  description String?
  severity    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks TaskTag[]
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model TaskNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
